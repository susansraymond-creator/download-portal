generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Existing schema preserved; Episode serials now support values such as 1-10.
// The complete model definitions remain unchanged except for Episode.episodeNumber.

model Episode {
  id            String     @id @default(cuid())
  seasonId      String
  season        Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber String
  title         String
  description   String?    @db.Text
  thumbnailUrl  String?
  duration      String?
  watchUrl      String?
  firstUploadedAt DateTime @default(now())
  lastUpdatedAt   DateTime @updatedAt

  downloadLinks EpisodeDownloadLink[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}
